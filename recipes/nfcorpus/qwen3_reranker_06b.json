{
  "schema_version": "1.0",
  "task": {"kind": "ranking"},
  "model": {
    "name_or_path": "Qwen/Qwen3-Reranker-0.6B",
    "revision": null,
    "layout": "pairs",
    "backend": "eager",
    "device": "cuda",
    "dtype": "bfloat16",
    "max_length": 2048,
    "pair_batch_size": 4
  },
  "data": {
    "manifest": "../../data/nfcorpus/manifest.json",
    "train_split": "train",
    "validation_split": "validation"
  },
  "training": {
    "epochs": 1,
    "learning_rate": 0.000002,
    "batch_size": 1,
    "gradient_accumulation_steps": 8,
    "seed": 42,
    "max_steps": -1,
    "save_steps": 100,
    "tuning": "lora",
    "gradient_checkpointing": true,
    "resume_from_checkpoint": null
  },
  "objective": {"bce_weight": 1.0, "pairwise_weight": 0.5},
  "output": {"root": "../../runs", "project": "nfcorpus"}
}
